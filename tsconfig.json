{
  "compilerOptions": {
    "target": "es2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["contracts", "scripts", "test", "web", "ignition", "typechain-types", "hardhat.config.ts", "vite.config.mts"],
  "exclude": ["node_modules", "web/dist", "artifacts", "cache"]
}
