# Deployer private key (without 0x prefix or with 0x prefix)
DEPLOYER_PRIVATE_KEY=your_private_key_here
# signs the deployment and seeding trasnactions when deploying to Base Sepolia (--network baseSepolia)
# is found in any EVM Wallet
# it will need Base Sepolia testnet ETH to pay gas

# Base Sepolia RPC endpoint
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# the RPC endpoint used by Harhat and backend scripts to interact with Base sepolia testnet

# Server-side HMAC secret for deriving harvester per-batch pseudonyms
PSEUDONYM_SECRET=your_pseudonym_secret_key_here
# used by the off-chain relayer 'derivation.ts' to derive HMAC-SHA256 privacy pseudonyms so a harvester's mobile number or group ID Is never exposed on the public bloackchain
# to generate a secure secret, in the terminal run 'openssl rand -hex 32'

# Etherscan V2 API key (covers all supported networks including Base Sepolia).
# Obtain from: https://etherscan.io/myapikey
# One key covers Base Sepolia — do NOT use a separate Basescan key.
ETHERSCAN_API_KEY=your_etherscan_api_key_here
